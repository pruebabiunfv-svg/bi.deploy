# LOCAL DEVELOPMENT ONLY. Never commit real secrets.
FLASK_ENV=development
APP_NAME=Business Analytics - Inversiones a Largo Plazo
PORT=5000

# Analytics
# Diez empresas seleccionables; SPY es únicamente benchmark, no empresa.
TICKERS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,NFLX,AMD,ORCL
BENCHMARK_TICKER=SPY
MARKET_PERIOD=10y
PREDICTION_HORIZON_DAYS=126
NEWS_PER_TICKER=15
FINBERT_MAX_NEW_PER_TICKER=6
HF_MAX_ATTEMPTS=3
WALK_FORWARD_FOLDS=4
GDELT_DELAY_SECONDS=3
YAHOO_ENRICHMENT_ENABLED=true

# Seguridad de almacenamiento: nunca incluir SEC completo en raw por defecto.
RAW_AUDIT_MODE=bounded
RAW_PAYLOAD_MAX_BYTES=65536

# Local MySQL example
# Railway NO debe usar ALLOW_LOCAL_MYSQL=true.
ALLOW_LOCAL_MYSQL=true
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
APP_DATABASE=inversion_bi

# External APIs
FRED_API_KEY=
SEC_USER_AGENT=BusinessAnalytics/1.0 correo@example.com

# Hugging Face / FinBERT
HF_TOKEN=
HF_MODEL=ProsusAI/finbert
HF_API_BASE=https://router.huggingface.co/hf-inference/models

# Gemini Agent
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_BASE_SECONDS=4
GEMINI_BETWEEN_CALLS_SECONDS=1.5

# Power BI / public read-only analytics endpoints
# true = Power BI can read analytics endpoints anonymously.
PUBLIC_ANALYTICS=true
# Optional: only used when PUBLIC_ANALYTICS=false and for /api/database/health
PBI_API_KEY=
