# LOCAL DEVELOPMENT ONLY. Never commit real secrets.
FLASK_ENV=development
APP_NAME=Business Analytics - Inversiones a Largo Plazo
PORT=5000

# Analytics
TICKERS=AAPL,MSFT,NVDA,AMZN,GOOGL,SPY,QQQ
MARKET_PERIOD=10y
PREDICTION_HORIZON_DAYS=126
NEWS_PER_TICKER=25
WALK_FORWARD_FOLDS=4

# Local MySQL example
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
APP_DATABASE=inversion_bi

# External APIs
FRED_API_KEY=
SEC_USER_AGENT=BusinessAnalytics/1.0 correo@example.com

# Hugging Face / FinBERT
HF_TOKEN=
HF_MODEL=ProsusAI/finbert
HF_API_BASE=https://router.huggingface.co/hf-inference/models

# Gemini Agent
GEMINI_API_KEY=
GEMINI_MODEL=

# Power BI / public read-only analytics endpoints
# true = Power BI can read analytics endpoints anonymously.
PUBLIC_ANALYTICS=true
# Optional: only used when PUBLIC_ANALYTICS=false and for /api/database/health
PBI_API_KEY=
