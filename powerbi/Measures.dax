-- MODELO V2: todos los KPI por empresa salen de DashboardAssets.
-- Cree un slicer con DimActivo[Empresa] o DimActivo[Ticker].

DimActivo =
DISTINCT(
    SELECTCOLUMNS(
        DashboardAssets,
        "Ticker", DashboardAssets[ticker],
        "Empresa", DashboardAssets[company_name]
    )
)

-- Relación: DimActivo[Ticker] (1) -> DashboardAssets[ticker] (*)
-- Relación: DimActivo[Ticker] (1) -> MarketHistory[ticker] (*)

Activo Seleccionado =
SELECTEDVALUE(DashboardAssets[ticker], "Seleccione un activo")

Empresa Seleccionada =
SELECTEDVALUE(DashboardAssets[company_name], "Seleccione un activo")

-- KPI de la empresa seleccionada
Probabilidad Favorable = MAX(DashboardAssets[probability_favorable])
Score Sentimiento = MAX(DashboardAssets[sentiment_score])
Rentabilidad Backtesting = MAX(DashboardAssets[backtesting_return])
Benchmark Return = MAX(DashboardAssets[benchmark_return])
Maximum Drawdown = MAX(DashboardAssets[max_drawdown])
Hit Rate Backtesting = MAX(DashboardAssets[hit_rate])
Nivel Confianza Modelo = MAX(DashboardAssets[roc_auc])
Accuracy Modelo = MAX(DashboardAssets[accuracy])
F1 Modelo = MAX(DashboardAssets[f1_score])
Score Final = MAX(DashboardAssets[final_score])
Posicion Ranking = MAX(DashboardAssets[ranking_position])
Decision Activo = MAX(DashboardAssets[decision_label])
Noticias Analizadas = MAX(DashboardAssets[news_count])
Precio Actual = MAX(DashboardAssets[close_price])

-- Mejor activo global: ignora el slicer para que siempre represente al #1 del motor.
Mejor Activo IA =
CALCULATE(
    MAX(DashboardAssets[ticker]),
    REMOVEFILTERS(DimActivo),
    DashboardAssets[is_best] = 1
)

Mejor Empresa IA =
CALCULATE(
    MAX(DashboardAssets[company_name]),
    REMOVEFILTERS(DimActivo),
    DashboardAssets[is_best] = 1
)

Score Mejor Activo =
CALCULATE(
    MAX(DashboardAssets[final_score]),
    REMOVEFILTERS(DimActivo),
    DashboardAssets[is_best] = 1
)

Decision Mejor Activo =
CALCULATE(
    MAX(DashboardAssets[decision_label]),
    REMOVEFILTERS(DimActivo),
    DashboardAssets[is_best] = 1
)

-- Gemini explica únicamente el mejor activo del mismo run.
Comentario IA Mejor Activo =
CALCULATE(MAX(AIRecommendation[model_comment]), REMOVEFILTERS(DimActivo))

Motivo IA Mejor Activo =
CALCULATE(MAX(AIRecommendation[main_reason]), REMOVEFILTERS(DimActivo))

Comparacion IA =
CALCULATE(MAX(AIRecommendation[comparison_comment]), REMOVEFILTERS(DimActivo))

Explicacion IA Completa =
VAR Motivo = CALCULATE(MAX(AIRecommendation[main_reason]), REMOVEFILTERS(DimActivo))
VAR Positivo = CALCULATE(MAX(AIRecommendation[positive_factors]), REMOVEFILTERS(DimActivo))
VAR Riesgo = CALCULATE(MAX(AIRecommendation[risk_factors]), REMOVEFILTERS(DimActivo))
VAR Comparacion = CALCULATE(MAX(AIRecommendation[comparison_comment]), REMOVEFILTERS(DimActivo))
RETURN
    "Motivo: " & COALESCE(Motivo, "Gemini todavía no generó comentario")
    & UNICHAR(10) & UNICHAR(10)
    & "Factores favorables: " & COALESCE(Positivo, "-")
    & UNICHAR(10) & UNICHAR(10)
    & "Riesgos: " & COALESCE(Riesgo, "-")
    & UNICHAR(10) & UNICHAR(10)
    & "Comparación: " & COALESCE(Comparacion, "-")

-- Ranking: gráfico de barras con DashboardAssets[ticker] y DashboardAssets[final_score].
-- Histórico: línea con MarketHistory[price_date] y MarketHistory[close_price], filtrado por DimActivo.
